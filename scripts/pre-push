#!/bin/sh
# Bump the Settings release marker when a push does not already change it.
# A new commit cannot join the push already in progress, so the hook stops
# that push and asks for one more.

set -e

zero="0000000000000000000000000000000000000000"
root=$(git rev-parse --show-toplevel)
cd "$root"

file_at() {
  git show "$1:src/release.ts" 2>/dev/null || true
}

needs_bump=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ -z "$local_sha" ] || [ "$local_sha" = "$zero" ]; then
    continue
  fi
  if [ "$remote_sha" = "$zero" ]; then
    remote_file=""
  else
    remote_file=$(file_at "$remote_sha")
  fi
  local_file=$(file_at "$local_sha")
  if [ "$local_file" = "$remote_file" ]; then
    needs_bump=1
    break
  fi
done

if [ "$needs_bump" -eq 0 ]; then
  exit 0
fi

head_sha=$(git rev-parse HEAD)
if [ ! -f src/release.ts ]; then
  echo "src/release.ts is missing, so the release marker was not bumped." >&2
  exit 1
fi

worktree=$(cat src/release.ts)
remote_tip=$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)
if [ -n "$remote_tip" ]; then
  published=$(file_at "$remote_tip")
else
  published=""
fi

if [ "$worktree" = "$published" ] || [ "$worktree" = "$(file_at "$head_sha")" ]; then
  node scripts/bump-release.mjs
fi

git add src/release.ts
if git diff --cached --quiet -- src/release.ts; then
  echo "Release marker was already current." >&2
  exit 0
fi

git commit -m "chore: bump release marker" -- src/release.ts
label=$(sed -n "s/.*'\\(v[0-9.]*-prod\\)'.*/\\1/p" src/release.ts)
echo "Release marker is now ${label}. Run git push again to publish it." >&2
exit 1
